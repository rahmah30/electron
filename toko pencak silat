                                Pilih File
                            </button>
                            <span id="storeLogoName" class="text-sm text-gray-600 dark:text-gray-400">Tidak ada file dipilih</span>
                        </div>
                        <div class="mt-2">
                            <img id="storeLogoPreview" src="" alt="Preview Logo" class="hidden max-h-24">
                        </div>
