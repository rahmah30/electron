        // Generate Profit Report
        function generateProfitReport(transactions, period, startDate, endDate) {
            const reportContent = document.getElementById('reportContent');
            const chartContainer = document.getElementById('reportChart');
            
            // Format date range
            const startDateStr = formatDate(startDate);
            const endDateStr = formatDate(endDate);
            
            // Group transactions by period
            const groupedData = groupTransactionsByPeriod(transactions, period);
            
            // Get payroll expenses in date range
            const payrollExpenses = appData.payrollHistory.filter(payroll => {
                const payrollDate = new Date(payroll.date);
                return payrollDate >= startDate && payrollDate <= endDate;
            });
            
            // Group payroll by period
            const groupedPayroll = groupPayrollByPeriod(payrollExpenses, period);
            
            // Create content
            let content = `
                <div id="printArea">
                    <h3 class="text-xl font-bold mb-2">Laporan Laba/Rugi</h3>
                    <p class="mb-4">Periode: ${startDateStr} - ${endDateStr}</p>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full bordered-table">
                            <thead class="bg-gray-100 dark:bg-gray-700">
                                <tr>
                                    <th class="text-left">Periode</th>
                                    <th class="text-right">Penjualan</th>
                                    <th class="text-right">Modal Produk</th>
                                    <th class="text-right">Gaji Karyawan</th>
                                    <th class="text-right">Laba/Rugi</th>
                                </tr>
                            </thead>
                            <tbody>
            `;
            
            // Add summary rows
            let totalSales = 0;
            let totalCost = 0;
            let totalPayroll = 0;
            let totalProfit = 0;
            
            // Chart data
            const chartLabels = [];
            const salesData = [];
            const expensesData = [];
            const profitData = [];
            
            Object.entries(groupedData).forEach(([periodLabel, periodData]) => {
                // Calculate sales
                const periodTotalSales = periodData.reduce((sum, t) => sum + t.total, 0);
                
                // Calculate cost of goods sold
                const periodCost = periodData.reduce((sum, t) => {
                    return sum + t.items.reduce((itemSum, item) => {
                        const product = appData.products.find(p => p.id === item.id);
                        return itemSum + (product ? product.cost * item.quantity : 0);
                    }, 0);
                }, 0);
                
                // Get payroll for this period
                const periodPayroll = groupedPayroll[periodLabel] ? 
                    groupedPayroll[periodLabel].reduce((sum, p) => sum + p.totalAmount, 0) : 0;
                
                // Calculate profit
                const periodProfit = periodTotalSales - periodCost - periodPayroll;
                
                // Add to totals
                totalSales += periodTotalSales;
                totalCost += periodCost;
                totalPayroll += periodPayroll;
                totalProfit += periodProfit;
                
                // Add to chart data
                chartLabels.push(periodLabel);
                salesData.push(periodTotalSales);
                expensesData.push(periodCost + periodPayroll);
                profitData.push(periodProfit);
                
                content += `
                    <tr>
                        <td>${periodLabel}</td>
                        <td class="text-right">${formatCurrency(periodTotalSales)}</td>
                        <td class="text-right">${formatCurrency(periodCost)}</td>
                        <td class="text-right">${formatCurrency(periodPayroll)}</td>
                        <td class="text-right ${periodProfit < 0 ? 'text-red-500' : 'text-green-500'}">${formatCurrency(periodProfit)}</td>
                    </tr>
                `;
            });
            
            // Add total row
            content += `
                            </tbody>
                            <tfoot class="font-bold">
                                <tr>
                                    <td>Total</td>
                                    <td class="text-right">${formatCurrency(totalSales)}</td>
                                    <td class="text-right">${formatCurrency(totalCost)}</td>
                                    <td class="text-right">${formatCurrency(totalPayroll)}</td>
                                    <td class="text-right ${totalProfit < 0 ? 'text-red-500' : 'text-green-500'}">${formatCurrency(totalProfit)}</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            `;
            
            reportContent.innerHTML = content;
            
            // Create multi-data chart
            createMultiDataChart(chartContainer, chartLabels, 
                [
                    { label: 'Penjualan', data: salesData, backgroundColor: 'rgba(93, 92, 222, 0.5)' },
                    { label: 'Biaya', data: expensesData, backgroundColor: 'rgba(239, 68, 68, 0.5)' },
                    { label: 'Laba/Rugi', data: profitData, backgroundColor: 'rgba(34, 197, 94, 0.5)' }
                ]
            );
        }
        
