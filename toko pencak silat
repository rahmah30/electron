            </div>
        </div>
    </div>
    
    <script>
        // Data Store (in-memory)
        const appData = {
            store: {
                name: "Toko Pencak Silat",
                address: "Jl. Pahlawan No. 123, Kota",
                logo: "data:image/svg+xml;base64,"
            },
            products: [
                { id: 1, code: "PS001", name: "Baju Silat", category: "Pakaian", cost: 80000, price: 120000, stock: 25 },
                { id: 2, code: "PS002", name: "Celana Silat", category: "Pakaian", cost: 60000, price: 90000, stock: 30 },
                { id: 3, code: "PS003", name: "Sabuk Silat", category: "Pakaian", cost: 30000, price: 50000, stock: 40 },
                { id: 4, code: "PS004", name: "Golok Latihan", category: "Senjata", cost: 150000, price: 250000, stock: 15 },
                { id: 5, code: "PS005", name: "Tongkat Rotan", category: "Senjata", cost: 45000, price: 75000, stock: 20 },
                { id: 6, code: "PS006", name: "Target Tendangan", category: "Alat Latihan", cost: 200000, price: 350000, stock: 8 },
                { id: 7, code: "PS007", name: "Samsak", category: "Alat Latihan", cost: 350000, price: 550000, stock: 5 },
                { id: 8, code: "PS008", name: "Pelindung Dada", category: "Pelindung", cost: 120000, price: 200000, stock: 12 },
                { id: 9, code: "PS009", name: "Pelindung Kaki", category: "Pelindung", cost: 80000, price: 150000, stock: 18 },
                { id: 10, code: "PS010", name: "Sarung Tangan", category: "Pelindung", cost: 65000, price: 110000, stock: 22 }
            ],
            cart: [],
            transactions: [],
            employees: [
                { id: 1, name: "Ahmad Sulaiman", position: "Kasir", salary: 3000000, paymentStatus: "pending" },
                { id: 2, name: "Ratna Dewi", position: "Asisten Manager", salary: 4500000, paymentStatus: "pending" }
            ],
            payrollHistory: []
        };
        
        // Utility Functions
        function formatCurrency(amount) {
            return "Rp " + amount.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }
        
        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('id-ID', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });
        }
        
        function generateID(array) {
            return array.length > 0 ? Math.max(...array.map(item => item.id)) + 1 : 1;
        }
        
        // Initialize App
        document.addEventListener('DOMContentLoaded', function() {
            // Set current date for date inputs
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('reportStartDate').value = today;
            document.getElementById('reportEndDate').value = today;
            document.getElementById('payrollDate').value = today;
            
            // Initialize store info
            updateStoreInfo();
            
            // Load initial data
            loadProducts();
            loadInventory();
            loadEmployees();
            loadPayrollHistory();
            
            // Setup event listeners
            setupNavigation();
            setupPOS();
            setupInventory();
            setupReports();
            setupEmployees();
            setupSettings();
        });
        
        // Update Store Info
        function updateStoreInfo() {
            document.getElementById('storeName').textContent = appData.store.name;
            document.getElementById('storeAddress').textContent = appData.store.address;
            document.getElementById('storeLogo').src = appData.store.logo;
        }
        
        // Navigation
        function setupNavigation() {
            const navButtons = document.querySelectorAll('.nav-btn');
            navButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const targetId = this.getAttribute('data-target');
                    
                    // Hide all sections
                    document.querySelectorAll('main > section').forEach(section => {
                        section.classList.add('hidden');
                    });
                    
                    // Show target section
                    document.getElementById(targetId).classList.remove('hidden');
                    
                    // Update button styles
                    navButtons.forEach(btn => {
                        btn.classList.remove('bg-primary', 'text-white');
                        btn.classList.add('bg-gray-200', 'text-gray-800', 'dark:bg-gray-700', 'dark:text-gray-300');
                    });
                    
                    this.classList.remove('bg-gray-200', 'text-gray-800', 'dark:bg-gray-700', 'dark:text-gray-300');
                    this.classList.add('bg-primary', 'text-white');
                });
            });
        }
        
        // POS Section
        function setupPOS() {
            const searchProduct = document.getElementById('searchProduct');
            const categoryFilter = document.getElementById('categoryFilter');
            const discountInput = document.getElementById('discountInput');
            const paymentAmount = document.getElementById('paymentAmount');
            const processPayment = document.getElementById('processPayment');
            const cancelTransaction = document.getElementById('cancelTransaction');
            const closeReceiptBtn = document.getElementById('closeReceiptBtn');
            const printReceiptBtn = document.getElementById('printReceiptBtn');
            const newTransactionBtn = document.getElementById('newTransactionBtn');
            
            // Search and filter products
            searchProduct.addEventListener('input', function() {
                loadProducts();
            });
            
            categoryFilter.addEventListener('change', function() {
                loadProducts();
            });
            
            // Update totals when discount changes
            discountInput.addEventListener('input', function() {
                updateCartTotals();
            });
            
            // Calculate change when payment amount changes
            paymentAmount.addEventListener('input', function() {
                const total = calculateTotal();
                const payment = parseFloat(this.value) || 0;
                const change = payment - total;
                
                document.getElementById('changeAmount').textContent = change >= 0 ? formatCurrency(change) : "Rp 0";
                
                // Enable/disable payment button
                processPayment.disabled = payment < total || appData.cart.length === 0;
            });
            
            // Process payment
            processPayment.addEventListener('click', function() {
                const total = calculateTotal();
                const payment = parseFloat(paymentAmount.value) || 0;
                
                if (payment < total || appData.cart.length === 0) return;
                
                // Create transaction record
                const transaction = {
                    id: generateID(appData.transactions),
                    date: new Date(),
                    items: JSON.parse(JSON.stringify(appData.cart)),
                    subtotal: calculateSubtotal(),
                    discount: parseFloat(discountInput.value) || 0,
                    total: total,
                    payment: payment,
                    change: payment - total
                };
                
                // Calculate profit for this transaction
                transaction.profit = transaction.items.reduce((sum, item) => {
                    const product = appData.products.find(p => p.id === item.id);
                    return sum + ((item.price - product.cost) * item.quantity);
                }, 0);
                
                // Add to transactions
                appData.transactions.push(transaction);
                
                // Update inventory
                transaction.items.forEach(item => {
                    const product = appData.products.find(p => p.id === item.id);
                    if (product) {
                        product.stock -= item.quantity;
                    }
                });
                
                // Generate receipt
                generateReceipt(transaction);
                
                // Show receipt modal
                document.getElementById('receiptModal').classList.remove('hidden');
            });
            
            // Cancel transaction
            cancelTransaction.addEventListener('click', function() {
                if (confirm('Apakah Anda yakin ingin membatalkan transaksi ini?')) {
                    appData.cart = [];
                    updateCart();
                    updateCartTotals();
                    paymentAmount.value = '';
                    document.getElementById('changeAmount').textContent = 'Rp 0';
                }
            });
            
            // Close receipt modal
            closeReceiptBtn.addEventListener('click', function() {
                document.getElementById('receiptModal').classList.add('hidden');
            });
            
            // Print receipt
            printReceiptBtn.addEventListener('click', function() {
                window.print();
            });
            
            // Start new transaction
            newTransactionBtn.addEventListener('click', function() {
                document.getElementById('receiptModal').classList.add('hidden');
                appData.cart = [];
                updateCart();
                updateCartTotals();
                paymentAmount.value = '';
                document.getElementById('changeAmount').textContent = 'Rp 0';
                discountInput.value = 0;
            });
        }
        
        // Load Products
        function loadProducts() {
            const tableBody = document.getElementById('productTableBody');
            const searchTerm = document.getElementById('searchProduct').value.toLowerCase();
            const categoryFilter = document.getElementById('categoryFilter').value;
            
            // Filter products
            const filteredProducts = appData.products.filter(product => {
                const matchesSearch = product.name.toLowerCase().includes(searchTerm) || 
                                     product.code.toLowerCase().includes(searchTerm);
                const matchesCategory = categoryFilter === '' || product.category === categoryFilter;
                return matchesSearch && matchesCategory;
            });
            
            // Clear table
            tableBody.innerHTML = '';
            
            // Add products to table
            filteredProducts.forEach(product => {
                const row = document.createElement('tr');
                row.className = product.stock <= 0 ? 'bg-red-100 dark:bg-red-900/20' : 
                               (product.stock <= 5 ? 'bg-yellow-100 dark:bg-yellow-900/20' : '');
                
                row.innerHTML = `
                    <td class="py-2">${product.code}</td>
                    <td class="py-2">${product.name}</td>
                    <td class="py-2">${product.category}</td>
                    <td class="py-2 text-right">${formatCurrency(product.price)}</td>
                    <td class="py-2 text-right">${product.stock}</td>
                    <td class="py-2 text-center">
                        <button class="add-to-cart bg-primary hover:bg-secondary text-white py-1 px-3 rounded-lg text-sm ${product.stock <= 0 ? 'opacity-50 cursor-not-allowed' : ''}"
                                ${product.stock <= 0 ? 'disabled' : ''}>
                            Tambah
                        </button>
                    </td>
                `;
                
                tableBody.appendChild(row);
                
                // Add to cart event
                const addButton = row.querySelector('.add-to-cart');
                addButton.addEventListener('click', function() {
                    addToCart(product);
                });
            });
        }
        
        // Add to Cart
        function addToCart(product) {
            // Check if product is already in cart
            const existingItemIndex = appData.cart.findIndex(item => item.id === product.id);
            
            if (existingItemIndex !== -1) {
                // Check stock
                if (appData.cart[existingItemIndex].quantity >= product.stock) {
                    alert('Stok tidak mencukupi!');
                    return;
                }
                
                // Increment quantity
                appData.cart[existingItemIndex].quantity += 1;
            } else {
                // Add new item
                appData.cart.push({
                    id: product.id,
                    code: product.code,
                    name: product.name,
                    price: product.price,
                    quantity: 1
                });
            }
            
            updateCart();
            updateCartTotals();
        }
        
        // Update Cart
        function updateCart() {
            const cartItems = document.getElementById('cartItems');
            
            // Clear cart
            cartItems.innerHTML = '';
            
            // Add items to cart
            appData.cart.forEach((item, index) => {
                const row = document.createElement('tr');
                
                row.innerHTML = `
                    <td class="py-2">
                        <div class="font-medium">${item.name}</div>
                        <div class="text-xs text-gray-600 dark:text-gray-400">${item.code}</div>
                    </td>
                    <td class="py-2 text-right">
                        <div class="flex items-center justify-end">
                            <button class="decrement-qty bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-white w-6 h-6 flex items-center justify-center rounded">-</button>
                            <span class="mx-2">${item.quantity}</span>
                            <button class="increment-qty bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-white w-6 h-6 flex items-center justify-center rounded">+</button>
                        </div>
                    </td>
                    <td class="py-2 text-right">${formatCurrency(item.price * item.quantity)}</td>
                    <td class="py-2 text-center">
                        <button class="remove-item text-red-500 hover:text-red-700">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </td>
                `;
                
                cartItems.appendChild(row);
                
                // Decrement quantity
                const decrementBtn = row.querySelector('.decrement-qty');
                decrementBtn.addEventListener('click', function() {
                    if (item.quantity > 1) {
                        item.quantity -= 1;
                    } else {
                        appData.cart.splice(index, 1);
                    }
                    updateCart();
                    updateCartTotals();
                });
                
                // Increment quantity
                const incrementBtn = row.querySelector('.increment-qty');
                incrementBtn.addEventListener('click', function() {
                    const product = appData.products.find(p => p.id === item.id);
                    if (item.quantity < product.stock) {
                        item.quantity += 1;
                        updateCart();
                        updateCartTotals();
                    } else {
                        alert('Stok tidak mencukupi!');
                    }
                });
                
                // Remove item
                const removeBtn = row.querySelector('.remove-item');
                removeBtn.addEventListener('click', function() {
                    appData.cart.splice(index, 1);
                    updateCart();
                    updateCartTotals();
                });
            });
        }
        
        // Calculate Subtotal
        function calculateSubtotal() {
            return appData.cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        }
        
        // Calculate Total (after discount)
        function calculateTotal() {
            const subtotal = calculateSubtotal();
            const discountPercent = parseFloat(document.getElementById('discountInput').value) || 0;
            const discountAmount = subtotal * (discountPercent / 100);
            return subtotal - discountAmount;
        }
        
        // Update Cart Totals
        function updateCartTotals() {
            const subtotal = calculateSubtotal();
            const total = calculateTotal();
            
            document.getElementById('subtotal').textContent = formatCurrency(subtotal);
            document.getElementById('totalAmount').textContent = formatCurrency(total);
            
            // Update change
            const payment = parseFloat(document.getElementById('paymentAmount').value) || 0;
            const change = payment - total;
            document.getElementById('changeAmount').textContent = change >= 0 ? formatCurrency(change) : "Rp 0";
            
            // Enable/disable payment button
            document.getElementById('processPayment').disabled = payment < total || appData.cart.length === 0;
        }
        
        // Generate Receipt
        function generateReceipt(transaction) {
            const printArea = document.getElementById('printArea');
            
            const receiptDate = new Date(transaction.date).toLocaleDateString('id-ID', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
            
            // Create receipt content
            let receiptContent = `
                <div class="flex justify-center mb-2">
                    <img src="${appData.store.logo}" alt="Logo Toko" class="w-16 h-16">
                </div>
                <div class="text-center mb-4">
                    <div class="font-bold text-lg">${appData.store.name}</div>
                    <div class="text-sm">${appData.store.address}</div>
                    <div class="text-sm mt-1">Tanggal: ${receiptDate}</div>
                    <div class="text-sm">No. Transaksi: #${transaction.id.toString().padStart(4, '0')}</div>
                </div>
                <div class="border-t border-b border-black my-2 py-2">
                    <table class="w-full text-sm">
                        <thead>
                            <tr>
                                <th class="text-left font-bold">Item</th>
                                <th class="text-right font-bold">Qty</th>
                                <th class="text-right font-bold">Harga</th>
                                <th class="text-right font-bold">Total</th>
                            </tr>
                        </thead>
                        <tbody>
            `;
            
            // Add items
            transaction.items.forEach(item => {
                receiptContent += `
                    <tr>
                        <td>${item.name}</td>
                        <td class="text-right">${item.quantity}</td>
                        <td class="text-right">${formatCurrency(item.price)}</td>
                        <td class="text-right">${formatCurrency(item.price * item.quantity)}</td>
                    </tr>
                `;
            });
            
            // Add totals
            receiptContent += `
                        </tbody>
                    </table>
                </div>
                <div class="text-right">
                    <div class="flex justify-between">
                        <span>Subtotal:</span>
                        <span>${formatCurrency(transaction.subtotal)}</span>
                    </div>
            `;
            
            // Add discount if applied
            if (transaction.discount > 0) {
                receiptContent += `
                    <div class="flex justify-between">
                        <span>Diskon (${transaction.discount}%):</span>
                        <span>-${formatCurrency(transaction.subtotal * (transaction.discount / 100))}</span>
                    </div>
                `;
            }
            
            // Add final totals
            receiptContent += `
                    <div class="flex justify-between font-bold mt-1">
                        <span>Total:</span>
                        <span>${formatCurrency(transaction.total)}</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Tunai:</span>
                        <span>${formatCurrency(transaction.payment)}</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Kembalian:</span>
                        <span>${formatCurrency(transaction.change)}</span>
                    </div>
                </div>
                <div class="text-center mt-6 text-sm">
                    <p>Terima Kasih Atas Kunjungan Anda</p>
                </div>
            `;
            
            printArea.innerHTML = receiptContent;
        }
        
        // Inventory Section
        function setupInventory() {
            const searchInventory = document.getElementById('searchInventory');
            const invCategoryFilter = document.getElementById('invCategoryFilter');
            const stockFilter = document.getElementById('stockFilter');
            const addProductBtn = document.getElementById('addProductBtn');
            const productForm = document.getElementById('productForm');
            const closeProductBtn = document.getElementById('closeProductBtn');
            const stockForm = document.getElementById('stockForm');
            const closeStockBtn = document.getElementById('closeStockBtn');
            
            // Search and filter inventory
            searchInventory.addEventListener('input', function() {
                loadInventory();
            });
            
            invCategoryFilter.addEventListener('change', function() {
                loadInventory();
            });
            
            stockFilter.addEventListener('change', function() {
                loadInventory();
            });
            
            // Add product button
            addProductBtn.addEventListener('click', function() {
                // Reset form
                productForm.reset();
                document.getElementById('productId').value = '';
                document.getElementById('productModalTitle').textContent = 'Tambah Produk';
                
                // Show modal
                document.getElementById('productModal').classList.remove('hidden');
            });
            
            // Close product modal
            closeProductBtn.addEventListener('click', function() {
                document.getElementById('productModal').classList.add('hidden');
            });
            
            // Submit product form
            productForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const productId = document.getElementById('productId').value;
                const code = document.getElementById('productCode').value;
                const name = document.getElementById('productName').value;
                const category = document.getElementById('productCategory').value;
                const cost = parseFloat(document.getElementById('productCost').value);
                const price = parseFloat(document.getElementById('productPrice').value);
                const stock = parseInt(document.getElementById('productStock').value);
                
                // Validate code uniqueness
                const existingProduct = appData.products.find(p => p.code === code && (!productId || p.id != productId));
                if (existingProduct) {
                    alert('Kode produk sudah digunakan. Silakan gunakan kode lain.');
                    return;
                }
                
                if (productId) {
                    // Update existing product
                    const index = appData.products.findIndex(p => p.id == productId);
                    if (index !== -1) {
                        appData.products[index] = {
                            id: parseInt(productId),
                            code,
                            name,
                            category,
                            cost,
                            price,
                            stock
                        };
                    }
                } else {
                    // Add new product
                    appData.products.push({
                        id: generateID(appData.products),
                        code,
                        name,
                        category,
                        cost,
                        price,
                        stock
                    });
                }
                
                // Close modal
                document.getElementById('productModal').classList.add('hidden');
                
                // Refresh inventory
                loadInventory();
                loadProducts();
            });
            
            // Close stock modal
            closeStockBtn.addEventListener('click', function() {
                document.getElementById('stockModal').classList.add('hidden');
            });
            
            // Submit stock form
            stockForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const productId = document.getElementById('stockProductId').value;
                const updateType = document.getElementById('stockUpdateType').value;
                const quantity = parseInt(document.getElementById('stockQuantity').value);
                
                const product = appData.products.find(p => p.id == productId);
                if (!product) return;
                
                switch (updateType) {
                    case 'add':
                        product.stock += quantity;
                        break;
                    case 'subtract':
                        if (product.stock < quantity) {
                            alert('Stok tidak mencukupi untuk pengurangan!');
                            return;
                        }
                        product.stock -= quantity;
                        break;
                    case 'set':
                        product.stock = quantity;
                        break;
                }
                
                // Close modal
                document.getElementById('stockModal').classList.add('hidden');
                
                // Refresh inventory
                loadInventory();
                loadProducts();
            });
        }
        
