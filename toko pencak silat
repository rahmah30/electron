                const name = document.getElementById('employeeName').value;
                const position = document.getElementById('employeePosition').value;
                const salary = parseFloat(document.getElementById('employeeSalary').value);
                
                if (employeeId) {
                    // Update existing employee
                    const index = appData.employees.findIndex(e => e.id == employeeId);
                    if (index !== -1) {
                        appData.employees[index] = {
                            id: parseInt(employeeId),
                            name,
                            position,
                            salary,
                            paymentStatus: appData.employees[index].paymentStatus
                        };
                    }
                } else {
                    // Add new employee
                    appData.employees.push({
                        id: generateID(appData.employees),
                        name,
                        position,
                        salary,
                        paymentStatus: 'pending'
                    });
                }
                
                // Close modal
                document.getElementById('employeeModal').classList.add('hidden');
                
                // Refresh employees
                loadEmployees();
            });
            
            // Process payroll button
            processPayrollBtn.addEventListener('click', function() {
                const period = document.getElementById('payrollPeriod').value;
                const date = document.getElementById('payrollDate').value;
                
                if (!date) {
                    alert('Silakan pilih tanggal gajian.');
                    return;
                }
                
                // Check if all employees are pending payment
                const pendingEmployees = appData.employees.filter(e => e.paymentStatus === 'pending');
                if (pendingEmployees.length === 0) {
                    alert('Tidak ada karyawan yang belum dibayar.');
                    return;
                }
                
                // Calculate total payroll
                const totalAmount = pendingEmployees.reduce((sum, e) => sum + e.salary, 0);
                
                // Create payroll record
                const payroll = {
                    id: generateID(appData.payrollHistory),
                    date: new Date(date),
                    period,
                    totalAmount,
                    employeeCount: pendingEmployees.length,
                    employees: pendingEmployees.map(e => ({
                        id: e.id,
                        name: e.name,
                        position: e.position,
                        salary: e.salary
                    }))
                };
                
                // Add to payroll history
                appData.payrollHistory.push(payroll);
                
                // Update employee payment status
                pendingEmployees.forEach(e => {
                    const employee = appData.employees.find(emp => emp.id === e.id);
                    if (employee) {
                        employee.paymentStatus = 'paid';
                    }
                });
                
                // Refresh data
                loadEmployees();
                loadPayrollHistory();
                
                alert('Penggajian berhasil diproses.');
            });
            
            // Close payroll detail modal
            closePayrollDetailBtn.addEventListener('click', function() {
                document.getElementById('payrollDetailModal').classList.add('hidden');
            });
            
            // Print payroll detail
            printPayrollDetailBtn.addEventListener('click', function() {
                window.print();
            });
        }
        
        // Load Employees
        function loadEmployees() {
            const tableBody = document.getElementById('employeeTableBody');
            
            // Clear table
            tableBody.innerHTML = '';
            
            // Add employees to table
            appData.employees.forEach(employee => {
                const row = document.createElement('tr');
                
                row.innerHTML = `
                    <td class="py-2">EMP-${employee.id.toString().padStart(3, '0')}</td>
                    <td class="py-2">${employee.name}</td>
                    <td class="py-2">${employee.position}</td>
                    <td class="py-2 text-right">${formatCurrency(employee.salary)}</td>
                    <td class="py-2 text-center">
                        <span class="px-2 py-1 rounded-full text-xs ${employee.paymentStatus === 'paid' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400'}">
                            ${employee.paymentStatus === 'paid' ? 'Sudah Dibayar' : 'Belum Dibayar'}
                        </span>
                    </td>
                    <td class="py-2 text-center">
                        <div class="flex justify-center space-x-1">
                            <button class="edit-employee bg-primary hover:bg-secondary text-white py-1 px-2 rounded-lg text-sm">
                                Edit
                            </button>
                            <button class="reset-payment ${employee.paymentStatus === 'pending' ? 'hidden' : ''} bg-orange-500 hover:bg-orange-600 text-white py-1 px-2 rounded-lg text-sm">
                                Reset
                            </button>
                            <button class="delete-employee bg-red-500 hover:bg-red-600 text-white py-1 px-2 rounded-lg text-sm">
                                Hapus
                            </button>
                        </div>
                    </td>
                `;
                
                tableBody.appendChild(row);
                
                // Edit employee event
                const editButton = row.querySelector('.edit-employee');
                editButton.addEventListener('click', function() {
                    // Fill form with employee data
                    document.getElementById('employeeId').value = employee.id;
                    document.getElementById('employeeName').value = employee.name;
                    document.getElementById('employeePosition').value = employee.position;
                    document.getElementById('employeeSalary').value = employee.salary;
                    
                    // Update modal title
                    document.getElementById('employeeModalTitle').textContent = 'Edit Karyawan';
                    
                    // Show modal
                    document.getElementById('employeeModal').classList.remove('hidden');
                });
                
                // Reset payment status
                const resetButton = row.querySelector('.reset-payment');
                resetButton.addEventListener('click', function() {
                    if (confirm(`Apakah Anda yakin ingin mereset status pembayaran untuk ${employee.name}?`)) {
                        employee.paymentStatus = 'pending';
                        loadEmployees();
                    }
                });
                
                // Delete employee event
                const deleteButton = row.querySelector('.delete-employee');
                deleteButton.addEventListener('click', function() {
                    if (confirm(`Apakah Anda yakin ingin menghapus karyawan ${employee.name}?`)) {
                        const index = appData.employees.findIndex(e => e.id === employee.id);
                        if (index !== -1) {
                            appData.employees.splice(index, 1);
                            loadEmployees();
                        }
                    }
                });
            });
        }
        
        // Load Payroll History
        function loadPayrollHistory() {
            const tableBody = document.getElementById('payrollHistoryTableBody');
            
            // Clear table
            tableBody.innerHTML = '';
            
            // Sort payroll history by date (newest first)
            const sortedPayroll = [...appData.payrollHistory].sort((a, b) => new Date(b.date) - new Date(a.date));
            
            // Add payroll history to table
            if (sortedPayroll.length > 0) {
                sortedPayroll.forEach(payroll => {
                    const row = document.createElement('tr');
                    
                    row.innerHTML = `
                        <td class="py-2">${formatDate(payroll.date)}</td>
                        <td class="py-2">${payroll.period === 'weekly' ? 'Mingguan' : 'Bulanan'}</td>
                        <td class="py-2 text-right">${formatCurrency(payroll.totalAmount)}</td>
                        <td class="py-2 text-right">${payroll.employeeCount}</td>
                        <td class="py-2 text-center">
                            <button class="view-payroll bg-primary hover:bg-secondary text-white py-1 px-3 rounded-lg text-sm">
                                Detail
                            </button>
                        </td>
                    `;
                    
                    tableBody.appendChild(row);
                    
                    // View payroll detail event
                    const viewButton = row.querySelector('.view-payroll');
                    viewButton.addEventListener('click', function() {
                        showPayrollDetail(payroll);
                    });
                });
            } else {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-4 text-center">Belum ada riwayat penggajian</td>
                    </tr>
                `;
            }
        }
        
        // Show Payroll Detail
        function showPayrollDetail(payroll) {
            const detailContent = document.getElementById('payrollDetailContent');
            
            // Format date
            const payrollDate = formatDate(payroll.date);
            
            // Create content
            let content = `
                <div id="printArea">
                    <h3 class="text-lg font-bold mb-2">Detail Penggajian</h3>
                    <div class="mb-4">
                        <p><strong>Tanggal:</strong> ${payrollDate}</p>
                        <p><strong>Periode:</strong> ${payroll.period === 'weekly' ? 'Mingguan' : 'Bulanan'}</p>
                        <p><strong>Total Gaji:</strong> ${formatCurrency(payroll.totalAmount)}</p>
                        <p><strong>Jumlah Karyawan:</strong> ${payroll.employeeCount}</p>
                    </div>
                    
                    <h4 class="font-bold mb-2">Daftar Karyawan</h4>
                    <table class="w-full bordered-table">
                        <thead class="bg-gray-100 dark:bg-gray-700">
                            <tr>
                                <th class="text-left">ID</th>
                                <th class="text-left">Nama</th>
                                <th class="text-left">Posisi</th>
                                <th class="text-right">Gaji</th>
                            </tr>
                        </thead>
                        <tbody>
            `;
            
            // Add employee rows
            payroll.employees.forEach(employee => {
                content += `
                    <tr>
                        <td class="py-2">EMP-${employee.id.toString().padStart(3, '0')}</td>
                        <td class="py-2">${employee.name}</td>
                        <td class="py-2">${employee.position}</td>
                        <td class="py-2 text-right">${formatCurrency(employee.salary)}</td>
                    </tr>
                `;
            });
            
            content += `
                        </tbody>
                        <tfoot class="font-bold">
                            <tr>
                                <td colspan="3" class="text-right">Total:</td>
                                <td class="text-right">${formatCurrency(payroll.totalAmount)}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            `;
            
            detailContent.innerHTML = content;
            
            // Show modal
            document.getElementById('payrollDetailModal').classList.remove('hidden');
        }
        
        // Settings
        function setupSettings() {
            const settingsBtn = document.getElementById('settingsBtn');
            const closeSettingsBtn = document.getElementById('closeSettingsBtn');
            const settingsForm = document.getElementById('settingsForm');
            const storeLogoBtn = document.getElementById('storeLogoBtn');
            const storeLogoInput = document.getElementById('storeLogoInput');
            
            // Show settings modal
            settingsBtn.addEventListener('click', function() {
                // Fill form with store data
                document.getElementById('storeNameInput').value = appData.store.name;
                document.getElementById('storeAddressInput').value = appData.store.address;
                
                // Show logo preview
                const storeLogoPreview = document.getElementById('storeLogoPreview');
                storeLogoPreview.src = appData.store.logo;
                storeLogoPreview.classList.remove('hidden');
                
                // Show modal
                document.getElementById('settingsModal').classList.remove('hidden');
            });
            
            // Close settings modal
            closeSettingsBtn.addEventListener('click', function() {
                document.getElementById('settingsModal').classList.add('hidden');
            });
            
            // Logo upload button
            storeLogoBtn.addEventListener('click', function() {
                storeLogoInput.click();
            });
            
            // Logo input change
            storeLogoInput.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    
                    reader.onload = function(e) {
                        const storeLogoPreview = document.getElementById('storeLogoPreview');
                        storeLogoPreview.src = e.target.result;
                        storeLogoPreview.classList.remove('hidden');
                        
                        document.getElementById('storeLogoName').textContent = file.name;
                    };
                    
                    reader.readAsDataURL(file);
                }
            });
            
            // Submit settings form
            settingsForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                // Update store data
                appData.store.name = document.getElementById('storeNameInput').value;
                appData.store.address = document.getElementById('storeAddressInput').value;
                
                // Update logo if changed
                const storeLogoPreview = document.getElementById('storeLogoPreview');
                if (!storeLogoPreview.classList.contains('hidden')) {
                    appData.store.logo = storeLogoPreview.src;
                }
                
                // Update store info
                updateStoreInfo();
                
                // Close modal
                document.getElementById('settingsModal').classList.add('hidden');
                
                // Show success message
                alert('Pengaturan toko berhasil disimpan.');
            });
        }
    </script>
</body>
</html>
