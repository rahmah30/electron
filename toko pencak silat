        // Group Transactions by Period
        function groupTransactionsByPeriod(transactions, period) {
            const groupedData = {};
            
            transactions.forEach(transaction => {
                const date = new Date(transaction.date);
                let periodLabel;
                
                switch (period) {
                    case 'daily':
                        periodLabel = formatDate(date);
                        break;
                    case 'weekly':
                        // Get week number and year
                        const weekNumber = getWeekNumber(date);
                        periodLabel = `Minggu ${weekNumber}, ${date.getFullYear()}`;
                        break;
                    case 'monthly':
                        // Format as month and year
                        periodLabel = date.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
                        break;
                }
                
                if (!groupedData[periodLabel]) {
                    groupedData[periodLabel] = [];
                }
                
                groupedData[periodLabel].push(transaction);
            });
            
            return groupedData;
        }
        
        // Group Payroll by Period
        function groupPayrollByPeriod(payrollData, period) {
            const groupedData = {};
            
            payrollData.forEach(payroll => {
                const date = new Date(payroll.date);
                let periodLabel;
                
                switch (period) {
                    case 'daily':
                        periodLabel = formatDate(date);
                        break;
                    case 'weekly':
                        // Get week number and year
                        const weekNumber = getWeekNumber(date);
                        periodLabel = `Minggu ${weekNumber}, ${date.getFullYear()}`;
                        break;
                    case 'monthly':
                        // Format as month and year
                        periodLabel = date.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
                        break;
                }
                
                if (!groupedData[periodLabel]) {
                    groupedData[periodLabel] = [];
                }
                
                groupedData[periodLabel].push(payroll);
            });
            
            return groupedData;
        }
        
        // Get Week Number
        function getWeekNumber(date) {
            const d = new Date(date);
            d.setHours(0, 0, 0, 0);
            d.setDate(d.getDate() + 4 - (d.getDay() || 7));
            const yearStart = new Date(d.getFullYear(), 0, 1);
            return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
        }
        
        // Create Chart
        function createChart(container, label, labels, data) {
            // Clear previous chart
            container.innerHTML = '<canvas></canvas>';
            const canvas = container.querySelector('canvas');
            
            // Create new chart
            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: label,
                        data: data,
                        backgroundColor: 'rgba(93, 92, 222, 0.5)',
                        borderColor: 'rgba(93, 92, 222, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }
        
        // Create Multi-Data Chart
        function createMultiDataChart(container, labels, datasets) {
            // Clear previous chart
            container.innerHTML = '<canvas></canvas>';
            const canvas = container.querySelector('canvas');
            
            // Create new chart
            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }
        
        // Create Pie Chart
        function createPieChart(container, label, labels, data) {
            // Clear previous chart
            container.innerHTML = '<canvas></canvas>';
            const canvas = container.querySelector('canvas');
            
            // Generate colors
            const colors = generateColors(labels.length);
            
            // Create new chart
            new Chart(canvas, {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [{
                        label: label,
                        data: data,
                        backgroundColor: colors.background,
                        borderColor: colors.border,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });
        }
        
        // Generate colors for charts
        function generateColors(count) {
            const backgroundColors = [];
            const borderColors = [];
            
            const hueStep = 360 / count;
            
            for (let i = 0; i < count; i++) {
                const hue = i * hueStep;
                backgroundColors.push(`hsla(${hue}, 70%, 60%, 0.5)`);
                borderColors.push(`hsla(${hue}, 70%, 50%, 1)`);
            }
            
            return {
                background: backgroundColors,
                border: borderColors
            };
        }
        
