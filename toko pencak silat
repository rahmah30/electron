<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kasir Peralatan Pencak Silat</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <style>
        @media print {
            body * {
                visibility: hidden;
            }
            #printArea, #printArea * {
                visibility: visible;
            }
            #printArea {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
        
        .dark {
            color-scheme: dark;
        }
        
        /* Animasi loading */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(0, 0, 0, 0.1);
            border-radius: 50%;
            border-top-color: #5D5CDE;
            animation: spin 1s ease-in-out infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .dark .loading {
            border-color: rgba(255, 255, 255, 0.1);
            border-top-color: #5D5CDE;
        }
        
        /* Styling untuk struk */
        .receipt {
            font-family: 'Courier New', monospace;
            line-height: 1.2;
        }
        
        /* Tabel dengan border */
        .bordered-table {
            border-collapse: collapse;
        }
        
        .bordered-table th, .bordered-table td {
            border: 1px solid #e2e8f0;
            padding: 0.5rem;
        }
        
        .dark .bordered-table th, .dark .bordered-table td {
            border-color: #374151;
        }
    </style>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#5D5CDE',
                        secondary: '#4F46E5',
                    }
                }
            }
        }
        
        // Deteksi tema gelap/terang
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
        }
        
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', event => {
            if (event.matches) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        });
    </script>
</head>
<body class="bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-200 min-h-screen">
    <div class="container mx-auto px-4 py-6">
        <!-- Header -->
        <header class="flex flex-col md:flex-row justify-between items-center mb-6">
            <div class="flex items-center mb-4 md:mb-0">
                <img id="storeLogo" src="data:image/svg+xml;base64," alt="Logo Toko" class="w-12 h-12 mr-2">
                <div>
                    <h1 id="storeName" class="text-2xl font-bold text-primary">Toko Pencak Silat</h1>
                    <p id="storeAddress" class="text-sm text-gray-600 dark:text-gray-400">Jl. Pahlawan No. 123, Kota</p>
                </div>
            </div>
            <button id="settingsBtn" class="bg-primary hover:bg-secondary text-white py-2 px-4 rounded-lg">
                Pengaturan
            </button>
        </header>
        
        <!-- Navigation -->
        <nav class="mb-6 overflow-x-auto">
            <div class="flex space-x-2 min-w-max">
                <button class="nav-btn bg-primary text-white py-2 px-4 rounded-lg" data-target="posSec">Kasir</button>
                <button class="nav-btn bg-gray-200 text-gray-800 dark:bg-gray-700 dark:text-gray-300 py-2 px-4 rounded-lg" data-target="inventorySec">Stok Barang</button>
                <button class="nav-btn bg-gray-200 text-gray-800 dark:bg-gray-700 dark:text-gray-300 py-2 px-4 rounded-lg" data-target="reportSec">Laporan</button>
                <button class="nav-btn bg-gray-200 text-gray-800 dark:bg-gray-700 dark:text:gray-300 py-2 px-4 rounded-lg" data-target="employeeSec">Karyawan</button>
            </div>
        </nav>
        
        <!-- Main Content -->
        <main class="mb-6">
            <!-- POS Section -->
            <section id="posSec" class="active-section">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Product List -->
                    <div class="lg:col-span-2 bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
                        <h2 class="text-xl font-bold mb-4">Daftar Produk</h2>
                        <div class="mb-4 flex">
                            <input type="text" id="searchProduct" placeholder="Cari produk..." class="flex-grow border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                            <select id="categoryFilter" class="ml-2 border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                                <option value="">Semua Kategori</option>
                                <option value="Pakaian">Pakaian</option>
                                <option value="Alat Latihan">Alat Latihan</option>
                                <option value="Pelindung">Pelindung</option>
                                <option value="Senjata">Senjata</option>
                                <option value="Aksesoris">Aksesoris</option>
                            </select>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full bordered-table">
                                <thead class="bg-gray-100 dark:bg-gray-700">
                                    <tr>
                                        <th class="text-left">Kode</th>
                                        <th class="text-left">Nama Produk</th>
                                        <th class="text-left">Kategori</th>
                                        <th class="text-right">Harga</th>
                                        <th class="text-right">Stok</th>
                                        <th class="text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="productTableBody">
                                    <!-- Data produk akan diisi di sini -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Cart -->
                    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
                        <h2 class="text-xl font-bold mb-4">Keranjang Belanja</h2>
                        <div class="mb-4 max-h-80 overflow-y-auto">
                            <table class="w-full">
                                <thead class="bg-gray-100 dark:bg-gray-700">
                                    <tr>
                                        <th class="text-left py-2">Produk</th>
                                        <th class="text-right py-2">Qty</th>
                                        <th class="text-right py-2">Subtotal</th>
                                        <th class="text-center py-2">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="cartItems">
                                    <!-- Item keranjang akan diisi di sini -->
                                </tbody>
                            </table>
                        </div>
                        <div class="border-t border-gray-200 dark:border-gray-700 pt-4">
                            <div class="flex justify-between mb-2">
                                <span>Subtotal:</span>
                                <span id="subtotal">Rp 0</span>
                            </div>
                            <div class="flex justify-between mb-4">
                                <label for="discountInput" class="flex items-center">
                                    <span>Diskon (%):</span>
                                </label>
                                <input type="number" id="discountInput" min="0" max="100" value="0" 
                                       class="w-16 border border-gray-300 dark:border-gray-600 rounded px-2 py-1 text-right dark:bg-gray-700 text-base">
                            </div>
                            <div class="flex justify-between font-bold text-lg mb-6">
                                <span>Total:</span>
                                <span id="totalAmount">Rp 0</span>
                            </div>
                            <div class="flex justify-between mb-4">
                                <label for="paymentAmount" class="flex items-center">
                                    <span>Jumlah Bayar:</span>
                                </label>
                                <input type="number" id="paymentAmount" min="0" class="w-32 border border-gray-300 dark:border-gray-600 rounded px-2 py-1 text-right dark:bg-gray-700 text-base">
                            </div>
                            <div class="flex justify-between mb-6">
                                <span>Kembalian:</span>
                                <span id="changeAmount">Rp 0</span>
                            </div>
                            <button id="processPayment" class="w-full bg-primary hover:bg-secondary text-white py-3 px-4 rounded-lg font-bold disabled:opacity-50 disabled:cursor-not-allowed">
                                Proses Pembayaran
                            </button>
                            <button id="cancelTransaction" class="w-full mt-2 bg-red-500 hover:bg-red-600 text-white py-2 px-4 rounded-lg">
                                Batalkan Transaksi
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Receipt Modal -->
                <div id="receiptModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
                    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 max-w-md w-full mx-4">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-xl font-bold">Struk Pembelian</h3>
                            <button id="closeReceiptBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                        <div id="printArea" class="receipt p-4 bg-white text-black rounded">
                            <!-- Struk akan diisi di sini -->
                        </div>
                        <div class="flex justify-end mt-4 space-x-2">
                            <button id="printReceiptBtn" class="bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-white py-2 px-4 rounded-lg">
                                Cetak Struk
                            </button>
                            <button id="newTransactionBtn" class="bg-primary hover:bg-secondary text-white py-2 px-4 rounded-lg">
                                Transaksi Baru
                            </button>
                        </div>
                    </div>
                </div>
            </section>
            
            <!-- Inventory Section -->
            <section id="inventorySec" class="hidden">
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4 mb-6">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xl font-bold">Manajemen Stok Barang</h2>
                        <button id="addProductBtn" class="bg-primary hover:bg-secondary text-white py-2 px-4 rounded-lg">
                            Tambah Produk
                        </button>
                    </div>
                    <div class="mb-4 flex flex-wrap gap-2">
                        <input type="text" id="searchInventory" placeholder="Cari produk..." class="flex-grow border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                        <select id="invCategoryFilter" class="border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                            <option value="">Semua Kategori</option>
                            <option value="Pakaian">Pakaian</option>
                            <option value="Alat Latihan">Alat Latihan</option>
                            <option value="Pelindung">Pelindung</option>
                            <option value="Senjata">Senjata</option>
                            <option value="Aksesoris">Aksesoris</option>
                        </select>
                        <select id="stockFilter" class="border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                            <option value="all">Semua Stok</option>
                            <option value="low">Stok Menipis (≤ 5)</option>
                            <option value="out">Stok Habis</option>
                        </select>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full bordered-table">
                            <thead class="bg-gray-100 dark:bg-gray-700">
                                <tr>
                                    <th class="text-left">Kode</th>
                                    <th class="text-left">Nama Produk</th>
                                    <th class="text-left">Kategori</th>
                                    <th class="text-right">Modal</th>
                                    <th class="text-right">Harga Jual</th>
                                    <th class="text-right">Stok</th>
                                    <th class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="inventoryTableBody">
                                <!-- Data inventaris akan diisi di sini -->
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Product Modal -->
                <div id="productModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
                    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 max-w-md w-full mx-4">
                        <div class="flex justify-between items-center mb-4">
                            <h3 id="productModalTitle" class="text-xl font-bold">Tambah Produk</h3>
                            <button id="closeProductBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                        <form id="productForm" class="space-y-4">
                            <input type="hidden" id="productId">
                            <div>
                                <label for="productCode" class="block mb-1">Kode Produk:</label>
                                <input type="text" id="productCode" required class="w-full border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                            </div>
                            <div>
                                <label for="productName" class="block mb-1">Nama Produk:</label>
                                <input type="text" id="productName" required class="w-full border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                            </div>
                            <div>
                                <label for="productCategory" class="block mb-1">Kategori:</label>
                                <select id="productCategory" required class="w-full border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                                    <option value="">Pilih Kategori</option>
                                    <option value="Pakaian">Pakaian</option>
                                    <option value="Alat Latihan">Alat Latihan</option>
                                    <option value="Pelindung">Pelindung</option>
                                    <option value="Senjata">Senjata</option>
                                    <option value="Aksesoris">Aksesoris</option>
                                </select>
                            </div>
                            <div>
                                <label for="productCost" class="block mb-1">Modal (Rp):</label>
                                <input type="number" id="productCost" required min="0" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                            </div>
                            <div>
                                <label for="productPrice" class="block mb-1">Harga Jual (Rp):</label>
                                <input type="number" id="productPrice" required min="0" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                            </div>
                            <div>
                                <label for="productStock" class="block mb-1">Stok:</label>
                                <input type="number" id="productStock" required min="0" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                            </div>
                            <div class="flex justify-end pt-2">
                                <button type="submit" class="bg-primary hover:bg-secondary text-white py-2 px-6 rounded-lg">
                                    Simpan
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                
                <!-- Stock Update Modal -->
                <div id="stockModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
                    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 max-w-md w-full mx-4">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-xl font-bold">Update Stok</h3>
                            <button id="closeStockBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                        <form id="stockForm" class="space-y-4">
                            <input type="hidden" id="stockProductId">
                            <div>
                                <p id="stockProductName" class="font-bold text-lg"></p>
                                <p id="stockCurrentQty" class="text-gray-600 dark:text-gray-400"></p>
                            </div>
                            <div>
                                <label for="stockUpdateType" class="block mb-1">Jenis Update:</label>
                                <select id="stockUpdateType" required class="w-full border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                                    <option value="add">Tambah Stok</option>
                                    <option value="subtract">Kurangi Stok</option>
                                    <option value="set">Set Jumlah Stok</option>
                                </select>
                            </div>
                            <div>
                                <label for="stockQuantity" class="block mb-1">Jumlah:</label>
                                <input type="number" id="stockQuantity" required min="1" class="w-full border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                            </div>
                            <div class="flex justify-end pt-2">
                                <button type="submit" class="bg-primary hover:bg-secondary text-white py-2 px-6 rounded-lg">
                                    Update
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </section>
            
            <!-- Reports Section -->
            <section id="reportSec" class="hidden">
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4 mb-6">
                    <h2 class="text-xl font-bold mb-4">Laporan Keuangan</h2>
                    <div class="flex flex-wrap gap-4 mb-4">
                        <div>
                            <label for="reportType" class="block mb-1">Jenis Laporan:</label>
                            <select id="reportType" class="border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                                <option value="sales">Penjualan</option>
                                <option value="profit">Laba/Rugi</option>
                                <option value="inventory">Stok Barang</option>
                            </select>
                        </div>
                        <div>
                            <label for="reportPeriod" class="block mb-1">Periode:</label>
                            <select id="reportPeriod" class="border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                                <option value="daily">Harian</option>
                                <option value="weekly">Mingguan</option>
                                <option value="monthly">Bulanan</option>
                            </select>
                        </div>
                        <div>
                            <label for="reportStartDate" class="block mb-1">Tanggal Mulai:</label>
                            <input type="date" id="reportStartDate" class="border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                        </div>
                        <div>
                            <label for="reportEndDate" class="block mb-1">Tanggal Akhir:</label>
                            <input type="date" id="reportEndDate" class="border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                        </div>
                        <div class="flex items-end">
                            <button id="generateReportBtn" class="bg-primary hover:bg-secondary text-white py-2 px-4 rounded-lg">
                                Tampilkan Laporan
                            </button>
                        </div>
                    </div>
                    
                    <div id="reportChart" class="mb-6 h-64"></div>
                    
                    <div id="reportContent" class="mb-4">
                        <!-- Konten laporan akan diisi di sini -->
                    </div>
                    
                    <div class="flex justify-end">
                        <button id="printReportBtn" class="bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-white py-2 px-4 rounded-lg">
                            Cetak Laporan
                        </button>
                    </div>
                </div>
            </section>
            
            <!-- Employee Section -->
            <section id="employeeSec" class="hidden">
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4 mb-6">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xl font-bold">Manajemen Karyawan</h2>
                        <button id="addEmployeeBtn" class="bg-primary hover:bg-secondary text-white py-2 px-4 rounded-lg">
                            Tambah Karyawan
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full bordered-table">
                            <thead class="bg-gray-100 dark:bg-gray-700">
                                <tr>
                                    <th class="text-left">ID</th>
                                    <th class="text-left">Nama</th>
                                    <th class="text-left">Posisi</th>
                                    <th class="text-right">Gaji (Rp)</th>
                                    <th class="text-center">Status Gaji</th>
                                    <th class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="employeeTableBody">
                                <!-- Data karyawan akan diisi di sini -->
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Payroll Section -->
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
                    <h2 class="text-xl font-bold mb-4">Penggajian Karyawan</h2>
                    <div class="flex flex-wrap gap-4 mb-4">
                        <div>
                            <label for="payrollPeriod" class="block mb-1">Periode:</label>
                            <select id="payrollPeriod" class="border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                                <option value="weekly">Mingguan</option>
                                <option value="monthly">Bulanan</option>
                            </select>
                        </div>
                        <div>
                            <label for="payrollDate" class="block mb-1">Tanggal Gajian:</label>
                            <input type="date" id="payrollDate" class="border border-gray-300 dark:border-gray-600 rounded-lg py-2 px-4 dark:bg-gray-700 text-base">
                        </div>
                        <div class="flex items-end">
                            <button id="processPayrollBtn" class="bg-primary hover:bg-secondary text-white py-2 px-4 rounded-lg">
                                Proses Gajian
                            </button>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full bordered-table">
                            <thead class="bg-gray-100 dark:bg-gray-700">
                                <tr>
                                    <th class="text-left">Tanggal</th>
                                    <th class="text-left">Periode</th>
                                    <th class="text-right">Total Gaji (Rp)</th>
                                    <th class="text-right">Jumlah Karyawan</th>
                                    <th class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="payrollHistoryTableBody">
                                <!-- Riwayat penggajian akan diisi di sini -->
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Employee Modal -->
                <div id="employeeModal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
                    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 max-w-md w-full mx-4">
                        <div class="flex justify-between items-center mb-4">
                            <h3 id="employeeModalTitle" class="text-xl font-bold">Tambah Karyawan</h3>
                            <button id="closeEmployeeBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
